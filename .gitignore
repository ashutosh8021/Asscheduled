# dependencies
node_modules/
.pnp
.pnp.js

# next
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# secrets — .env.example is the only env file that may be committed
.env
.env.local
.env.*.local

# runtime / editor / os
.vercel/
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Camera video from shoots. These run to hundreds of megabytes and GitHub
# rejects anything over 100MB outright. Originals stay on the drive; the
# web cuts that actually ship live in public/video.
asset/**/*.MP4
asset/**/*.mp4
asset/**/*.MOV
asset/**/*.mov

# Screenshots and scratch output from verification runs. A mis-positioned
# argv once wrote one to a file called "x" in the repo root.
/.shots/
/x
.candidates/

# Payment QR codes. The repo is public, and a UPI QR carries an account
# holder's name, photo and UPI ID — publishing one is a disclosure, not
# an asset. Keep them on the drive; the site references a UPI ID from
# lib/copy.ts, which is a deliberate, reviewable line of text.
asset/**/*QR*
asset/**/*qr*
