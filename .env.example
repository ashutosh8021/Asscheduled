# AS SCHEDULED — environment
#
# Copy to .env.local and fill in. .env.local is NEVER committed.
# Every one of these is optional: with a group absent, that integration
# degrades cleanly rather than throwing.
#   - no Supabase  -> applications are validated and accepted, not stored
#   - no Razorpay  -> no ₹500 is charged, Form 7A ends at LODGED as in Phase 1
#   - no Resend    -> no confirmation email is sent
# Names are fixed by docs/SPEC.md §9.

# ---- Site -------------------------------------------------------------
# Canonical origin for metadata, sitemap, robots and OG images.
# Without it, absolute URLs fall back to the Vercel domain, then localhost.
# TODO(mannat): set once the live domain is registered.
NEXT_PUBLIC_SITE_URL=

# ---- Supabase (Phase 2) -----------------------------------------------
# Schema: docs/schema.sql. Server routes write with the service role key —
# keep that one out of any client component.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Razorpay (Phase 2) -----------------------------------------------
# KEY_ID and KEY_SECRET together enable order creation and Checkout.
# WEBHOOK_SECRET is read independently — it alone gates POST
# /api/razorpay/webhook, the only place fee_status becomes 'paid'.
# Point the Razorpay dashboard webhook at:
#   https://<your-domain>/api/razorpay/webhook
# subscribed to: payment.captured, order.paid
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Resend (Phase 2) -------------------------------------------------
# RESEND_FROM must be an address on a domain verified in Resend, e.g.
# "AS SCHEDULED <paperwork@yourdomain.in>". Without it nothing is sent.
RESEND_API_KEY=
RESEND_FROM=

# ---- Analytics / monitoring (Phase 4) ---------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=

# ---- Contact channels (public) ----------------------------------------
# All three are OPEN ITEMS. Unset means the UI says "not yet published"
# rather than shipping an invented handle or a stranger's phone number.
# NEXT_PUBLIC_CONTACT_EMAIL is required before launch: the privacy policy
# must name an address for data access and deletion requests.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# ---- Google Analytics 4 -----------------------------------------------
# Unset = no script, no cookie, no third-party request at all.
# Mark these as key events in GA4 once data flows:
#   application_lodged, payment_initiated, apply_start,
#   contact_click, whatsapp_click
NEXT_PUBLIC_GA_ID=

# ---- Google Search Console --------------------------------------------
# Only needed if verifying by meta tag rather than DNS. DNS is preferred.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------- Inbox
# Where form submissions are mailed. Comma-separated, no spaces. Falls
# back to info@asscheduled.com if unset.
SOMEWHERE_INBOX=

# ---------------------------------------------------------------- Admin
# Who may sign in at /admin. Comma-separated, must match a Supabase Auth
# user exactly. FAILS CLOSED — unset means nobody gets in, including you.
ADMIN_EMAILS=
