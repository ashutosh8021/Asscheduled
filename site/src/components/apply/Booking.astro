---
/* apply.html — section 1 of 1, carried across verbatim.
   See docs/PAGES.md for what it is and which hooks it carries. */
---

<div class="apply">
  <aside class="apply-side">
    <img src="/assets/img/apply-side.jpg" alt="" class="bgp" fetchpriority="high">
    <div class="halftone" style="--hx:80%;--hy:20%;--hx2:10%;--hy2:90%"></div>
    <div class="stack" style="gap:8px">
      <span class="label c-acid">Get your spot</span>
      <h1 class="d-l" style="max-width:9ch">Say yes <span class="it">first</span></h1>
      <p class="serif" style="font-size:clamp(26px,3vw,38px)">we’ll handle the panic</p>
    </div>
    <div class="bp-wrap">
    <div class="bp" aria-label="Your boarding pass preview" data-bp>
      <div class="bp-main">
        <div class="bp-band"><img src="/assets/brand/as-cream.png" alt="AS SCHEDULED" width="1000" height="160"><span>Boarding pass</span></div>
        <div class="bp-route">
          <div class="bp-pt"><small>From</small><b data-pass="fromCode" data-ph="YOU">YOU</b><span data-pass="from" data-ph="Your city">Your city</span></div>
          <div class="bp-path" aria-hidden="true"><i></i><img src="/assets/el/plane.webp" alt="" width="620" height="325" draggable="false"><i></i></div>
          <div class="bp-pt to"><small>To</small><b data-pass="toCode" data-ph="???">???</b><span data-pass="to" data-ph="Somewhere">Somewhere</span></div>
        </div>
        <div class="bp-fs">
          <div class="bp-f w2"><small>Passenger</small><b class="nm" data-pass="name" data-ph="YOUR/NAME">YOUR/NAME</b></div>
          <div class="bp-f"><small>Seq</small><b data-pass="seq" data-ph="001">001</b></div>
          <div class="bp-f"><small>Fest</small><b data-pass="fest" data-ph="Pick one">Pick one</b></div>
          <div class="bp-f"><small>Date</small><b data-pass="date" data-ph="Soon">Soon</b></div>
          <div class="bp-f"><small>Gate</small><b>Chaos</b></div>
          <div class="bp-f"><small>Seat</small><b>Any</b></div>
          <div class="bp-f w2"><small>Class</small><b class="it">Main character</b></div>
        </div>
      </div>
      <div class="bp-stub">
        <div class="bp-band"><span>Season 02</span></div>
        <div class="bp-stub-b">
          <div class="bp-sf"><small>To</small><b class="code" data-pass="toCode" data-ph="???">???</b></div>
          <div class="bp-sf"><small>Passenger</small><b data-pass="first" data-ph="You">You</b></div>
          <div class="bp-sf"><small>Package</small><b class="price" data-pass="price" data-ph="₹ ?">₹ ?</b></div>
          <canvas class="bp-code" aria-hidden="true"></canvas>
        </div>
      </div>
    </div>
    </div>
    <p class="label" style="color:rgba(243,236,224,.85);max-width:40ch;line-height:1.6">Your pass fills itself as you type ✱ nothing is sent until you tap WhatsApp</p>
  </aside>
  <section class="apply-main s-paper">
    <ol class="steps" aria-label="Booking steps"><li class="now"><span>01 · You</span></li><li><span>02 · The trip</span></li><li><span>03 · Lock it</span></li></ol>
    <form id="apply-form" novalidate>
      <div data-step="0">
        <h2 class="d-m">Who’s <span class="it">coming?</span></h2><p class="body muted mt-12">Two minutes, tops, we only ask what we need to book you in</p>
        <div class="fgrid mt-32">
          <div class="field full"><label for="a-name">Full name, as on your ID</label><input id="a-name" name="name" required autocomplete="name"><span class="err"></span></div>
          <div class="field"><label for="a-age">Age</label><input id="a-age" name="age" type="number" inputmode="numeric" min="18" max="99" required><span class="err"></span></div>
          <div class="field"><span class="lab">Gender</span><div class="radios" role="radiogroup" aria-label="Gender">
            <label><input type="radio" name="gender" value="Man"><span>Man</span></label><label><input type="radio" name="gender" value="Woman"><span>Woman</span></label><label><input type="radio" name="gender" value="Other"><span>Other</span></label></div></div>
          <div class="field"><label for="a-phone">WhatsApp number</label><input id="a-phone" name="phone" type="tel" inputmode="tel" required autocomplete="tel" placeholder="+91"><span class="err"></span></div>
          <div class="field"><label for="a-email">Email</label><input id="a-email" name="email" type="email" required autocomplete="email"><span class="err"></span></div>
          <div class="field full"><label for="a-college">College</label><input id="a-college" name="college" required><span class="err"></span></div>
          <div class="field"><label for="a-city">City</label><input id="a-city" name="city" required autocomplete="address-level2"><span class="err"></span></div>
          <div class="field"><label for="a-state">State</label><select id="a-state" name="state" required data-msg="Pick your state"><option value="">Select your state</option><option>Andhra Pradesh</option><option>Arunachal Pradesh</option><option>Assam</option><option>Bihar</option><option>Chhattisgarh</option><option>Goa</option><option>Gujarat</option><option>Haryana</option><option>Himachal Pradesh</option><option>Jharkhand</option><option>Karnataka</option><option>Kerala</option><option>Madhya Pradesh</option><option>Maharashtra</option><option>Manipur</option><option>Meghalaya</option><option>Mizoram</option><option>Nagaland</option><option>Odisha</option><option>Punjab</option><option>Rajasthan</option><option>Sikkim</option><option>Tamil Nadu</option><option>Telangana</option><option>Tripura</option><option>Uttar Pradesh</option><option>Uttarakhand</option><option>West Bengal</option><option>Andaman and Nicobar Islands</option><option>Chandigarh</option><option>Dadra and Nagar Haveli and Daman and Diu</option><option>Delhi</option><option>Jammu and Kashmir</option><option>Ladakh</option><option>Lakshadweep</option><option>Puducherry</option></select><span class="err"></span></div>
        </div>
        <div class="form-actions"><span class="label muted">Step 1 of 3</span><button class="btn" type="button" data-next data-cursor="Next">The trip <span class="ar" aria-hidden="true">→</span></button></div>
      </div>

      <div data-step="1" hidden>
        <h2 class="d-m">Where are we <span class="it">taking you?</span></h2><p class="body muted mt-12">Pick a departure, you can change your mind until you pay</p>
        <div class="plans plans-mini mt-32" data-plans data-noauto><label class="plan" data-id="hal5" for="p-hal5"><input type="radio" name="plan" id="p-hal5" value="hal5" required data-msg="Pick a plan">
  <div class="plan-top"><span class="plan-tag">5 days · 25 Nov → 29 Nov</span><span class="plan-tick" aria-hidden="true"></span></div><h3>Hallucia’26</h3>
  <div class="plan-price"><b class="tabular">₹9,999</b><small>per person</small></div></label><label class="plan" data-id="hal7" for="p-hal7"><input type="radio" name="plan" id="p-hal7" value="hal7" required data-msg="Pick a plan">
  <div class="plan-top"><span class="plan-tag">7 days · from 25 Nov</span><span class="plan-tick" aria-hidden="true"></span></div><h3>Hallucia × Pachmarhi</h3>
  <div class="plan-price"><b class="tabular">₹14,999</b><small>per person</small></div></label><label class="plan" data-id="mi4" for="p-mi4"><input type="radio" name="plan" id="p-mi4" value="mi4" required data-msg="Pick a plan">
  <div class="plan-top"><span class="plan-tag">4 days · December</span><span class="plan-tick" aria-hidden="true"></span></div><h3>Mood Indigo’26</h3>
  <div class="plan-price"><b class="tabular">₹8,499</b><small>per person</small></div></label><label class="plan" data-id="mi6" for="p-mi6"><input type="radio" name="plan" id="p-mi6" value="mi6" required data-msg="Pick a plan">
  <div class="plan-top"><span class="plan-tag">6 days · December</span><span class="plan-tick" aria-hidden="true"></span></div><h3>Mumbai + Mood Indigo</h3>
  <div class="plan-price"><b class="tabular">₹11,499</b><small>per person</small></div></label></div>
        <div class="coupon mt-24" data-coupon>
          <div class="cp-l">
            <span class="cp-tag"><b>✱</b> Coupon · auto-applied</span>
            <b class="cp-off" data-cp-off>₹500 off Hallucia, ₹1,000 off Mood Indigo</b>
            <span class="cp-note" data-cp-note>Pick a trip, it comes off your price on its own, no code to type</span>
          </div>
          <div class="cp-r" data-cp-r hidden>
            <small>Valid for the next</small>
            <span class="cp-digits" data-cp-digits></span>
            <small>bookings</small>
          </div>
        </div>
        <p class="err mt-16" id="plan-err" aria-live="polite"></p>
        <div class="fgrid mt-32">
          <div class="field"><label for="a-insta">Instagram handle, optional</label><input id="a-insta" name="insta" placeholder="@"></div>
          <div class="field"><label for="a-why">Why are you coming? optional</label><input id="a-why" name="why" placeholder="One line is enough"></div>
          <div class="full"><label class="check" for="a-terms"><input type="checkbox" id="a-terms" required data-msg="Tick this to continue"> <span>I’m 18 or over and I’ve read the <a href="terms.html">terms of travel</a> and the <a href="cancellation-policy.html">cancellation policy</a></span></label><p class="err mt-8" id="a-terms-err"></p></div>
        </div>
        <div class="form-actions"><button class="btn btn-ghost no-ar" type="button" data-back>← Back</button><button class="btn" type="button" data-next data-cursor="Next">Lock it <span class="ar" aria-hidden="true">→</span></button></div>
      </div>

      <div data-step="2" hidden>
        <h2 class="d-m">Lock <span class="it">your seat</span></h2><p class="body muted mt-12">Scan, pay the booking amount, send us the screenshot, that’s it</p>
        <div class="summary mt-32">
          <div class="summary-row"><span>Plan</span><b id="s-plan"></b></div>
          <div class="summary-row"><span>Where & when</span><b id="s-where"></b></div>
          <div class="summary-row"><span>Package</span><b class="tabular" id="s-price"></b></div>
          <div class="summary-row cp-row" id="s-cp-row" hidden><span>Coupon <em class="cp-code" id="s-cp-code"></em></span><b class="tabular" id="s-cp"></b></div>
          <div class="summary-row" id="s-pay-row" hidden><span>You pay</span><b class="tabular" id="s-pay"></b></div>
          <div class="summary-row"><span>Booking amount now</span><b class="tabular" id="s-dep"></b></div>
          <div class="summary-row"><span>Balance before departure</span><b class="tabular" id="s-bal"></b></div>
        </div>
        <p class="fine mt-16" id="s-travel"></p>
        <div class="pay">
          <div class="qr"><img src="/assets/brand/payment-qr.png" alt="UPI payment QR code" width="1080" height="1080"></div>
          <div class="stack" style="gap:10px"><span class="label muted">Scan with any UPI app and pay</span><span class="amount tabular" id="pay-amount">₹0</span>
            <div class="pay-btns"><a class="btn pay-app" id="upi-pay" href="upi://pay?pa=singhmannat936@okicici&amp;pn=Mannat%20singh%20chimni&amp;cu=INR" data-cursor="Pay">Pay in UPI app <span class="ar" aria-hidden="true">↗</span></a><button class="copybtn" type="button" data-copy="upi-id" data-cursor="Copy">Copy UPI ID</button></div>
            <p class="fine">UPI ID <b class="upi-id" id="upi-id">singhmannat936@okicici</b>, on your phone tap Pay in UPI app or copy the ID, use your own name in the payment note if your app lets you, then take a screenshot</p></div>
        </div>
        <label class="check mt-32" for="a-paid"><input type="checkbox" id="a-paid"> <span>I’ve paid the booking amount and I have the screenshot</span></label>

        {/* The screenshot, straight to us.
            WhatsApp stays — it is how people expect to send it and how
            you answer them — but a screenshot that only ever exists in a
            chat is a screenshot nobody can find when the booking needs
            checking against the bank. This puts the same image in the
            system, attached to this booking, the moment they pick it. */}
        <div class="shot mt-24" data-shot>
          <label class="label" for="a-shot">Payment screenshot</label>
          <input type="file" id="a-shot" accept="image/jpeg,image/png,image/webp" data-cursor="Pick">
          <p class="fine" data-shot-msg>JPG, PNG or WebP. Optional, but it gets your seat confirmed faster.</p>
        </div>
        <div class="row mt-24"><a class="btn btn-acid btn-xl" id="wa-send" href="https://wa.me/917853022360" target="_blank" rel="noopener" data-cursor="Send">Send on WhatsApp <span class="ar" aria-hidden="true">↗</span></a><button class="copybtn" type="button" data-copy="apply-text" data-cursor="Copy">Copy my details</button></div>
        <details class="mt-24"><summary class="label" style="cursor:pointer">See the message we’ll send</summary><pre id="apply-text" style="white-space:pre-wrap;font:400 14.5px/1.6 var(--f-mono);margin:14px 0 0;background:var(--paper);border:1.5px solid var(--ink);padding:16px;border-radius:6px"></pre></details>
        <p class="fine mt-24">Your seat is locked once we confirm on WhatsApp, usually within a few hours, if WhatsApp doesn’t open, message +91 78530 22360 with your screenshot and these details</p>
        <div class="form-actions"><button class="btn btn-ghost no-ar" type="button" data-back>← Change something</button><a class="link" href="faqs.html" data-cursor="Open">Questions first <span aria-hidden="true">→</span></a></div>
      </div>
    </form>
  </section>
</div>
