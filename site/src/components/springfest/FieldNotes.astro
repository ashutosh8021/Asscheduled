---
/* spring-fest.html — section 4 of 10.

   The night statement, same construction as hallucia/FieldNotes.astro:
   a [data-scrub] line over the halftone, leaks and floating cut-outs.
   The objects are the ones the other trip pages already use, so nothing
   new is loaded for this page. */
---

<section class="sec s-night">
  <div class="halftone" style="--hx:85%;--hy:20%;--hx2:10%;--hy2:85%"></div><div class="leak l-rust" style="left:50%;top:30%;width:60vw;height:60vw"></div><div class="leak l-pink" style="left:-10%;top:-20%;width:40vw;height:40vw"></div><img class="ghost" src="/assets/brand/as-ghost.webp" alt="" aria-hidden="true" loading="lazy" style="left:-30%;top:20%;transform:rotate(-6deg)"><div class="grainy"></div>
  <div class="obj" style="--x:74%;--y:-6%;--w:clamp(120px,28vw,280px);--r:10deg;--xd:80%;--yd:4%" data-depth="0.12" aria-hidden="true"><img src="/assets/el/sparkler.webp" alt="" width="607" height="620" loading="lazy" decoding="async" draggable="false"></div><div class="obj dof" style="--x:-8%;--y:62%;--w:clamp(110px,28vw,260px);--r:0deg;--xd:-4%;--yd:58%;--b:7px" data-depth="0.2" aria-hidden="true"><img src="/assets/el/vinyl.webp" alt="" width="507" height="509" loading="lazy" decoding="async" draggable="false"></div>
  <div class="wrap z">
    <p class="slug"><b>03</b><span>Three days, one campus</span><span class="ln"></span><span class="m hide-s">Field notes</span></p>
    <p class="d-l stmt" data-scrub>You wake up on campus and the commute <span class="it">is a walk</span>, the fest is already happening outside the hostel door</p>
  </div>
</section>
