      <div class="ccard"><small>Call or WhatsApp</small><span class="big tabular">+91 78530 22360<br>+91 89692 14005</span><a class="copybtn" href="https://wa.me/917853022360" target="_blank" rel="noopener" style="align-self:flex-start" data-cursor="Open">Open WhatsApp ↗</a></div>
    </div>
  </div>
</section>
