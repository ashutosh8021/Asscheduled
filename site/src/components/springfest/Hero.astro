---
/* spring-fest.html — section 1 of 10.

   New for Spring Fest 2027, not carried across from the Co-work
   original: there was no third departure when the site was migrated.
   It follows hallucia/Hero.astro hook for hook — same classes, same
   data-parallax on the hero image, same chip row — so the shared motion
   and the page-wipe treat it exactly like the other two trip pages. */
---

<section class="hero phero" aria-label="Kharagpur  Spring Fest">
  <div class="hero-media"><picture><source media="(max-width: 767px)" srcset="/assets/img/sf-hero-p.jpg"><img src="/assets/img/sf-hero-l.jpg" alt="Fireworks over the main stage on the last night of Spring Fest" fetchpriority="high" data-parallax="0.1"></picture></div>
  <div class="hero-copy">
    <span class="label">Spring Fest 2027 · IIT Kharagpur</span>
    <h1 class="h1">Kharagpur <span class="x-el"><img src="/assets/el/x.webp" alt="" width="524" height="620" draggable="false"></span> Spring Fest</h1>

    <div class="hero-meta"><span class="chip chip-solid"><span class="dot" aria-hidden="true"></span>Official Trip Partner</span><span class="chip">5 or 6 days</span><span class="chip">21 Jan → 26 Jan 2027</span><span class="chip">From ₹4,999</span></div>
    <div class="row row-center hero-ctas"><a class="btn btn-acid btn-buy" href="apply.html#sf5" data-cursor="Go">Get your spot<span class="ar" aria-hidden="true">→</span></a><a class="pill pill-ghost-light" href="#plans" data-cursor="See">Pick your plan</a></div>
  </div>
  <div class="hero-bottom"><span class="scroll-cue">Since 1960</span></div>
</section>
