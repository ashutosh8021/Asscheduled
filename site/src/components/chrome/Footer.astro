---
/* The footer. Identical on all 13 pages, byte for byte.
   source-site/index.html — the footer.foot block.

   It carries the newsletter form (#join, read by features/newsletter.js)
   and the year, filled in at runtime by the [data-year] line at the end
   of motion/count-up.js. */
import { SOCIAL } from '../../data/nav.js';
---

<footer class="foot">
  <div class="halftone" style="--hx:80%;--hy:15%;--hx2:5%;--hy2:75%"></div><div class="leak l-rust" style="left:-15%;top:30%;width:60vw;height:60vw"></div><div class="leak l-pink" style="left:70%;top:-20%;width:45vw;height:45vw"></div><img class="ghost" src="/assets/brand/as-ghost.webp" alt="" aria-hidden="true" loading="lazy" style="left:-30%;top:42%;transform:rotate(-6deg)"><div class="grainy"></div>
  <div class="obj" style="--x:78%;--y:3%;--w:clamp(80px,18vw,170px);--r:12deg;--xd:84%;--yd:8%" data-depth="0.1" aria-hidden="true"><img src="/assets/el/finger.webp" alt="" width="340" height="620" loading="lazy" decoding="async" draggable="false"></div>
  <div class="wrap">
    <p class="slug"><b>✱</b><span>The last page</span><span class="ln"></span><span class="m hide-s">AS SCHEDULED · Season 02</span></p>
    <div class="foot-cta">
      <h2 class="d-xl" data-split>Fuck ordinary <span class="it">weekends</span></h2>
      <div class="stack" style="gap:20px"><p class="serif">Say yes first, we’ll handle the panic</p><a class="btn btn-acid btn-xl" href="apply.html" data-cursor="Go">Get your spot<span class="ar" aria-hidden="true">→</span></a></div>
    </div>
    <div class="foot-grid">
      <form class="foot-news" id="join" data-news novalidate>
        <span class="label c-acid">Get the next one first</span>
        <h3>New departures drop here before they drop anywhere else</h3>
        <div class="news-field"><label class="sr" for="news-email">Email address</label>
          <input id="news-email" type="email" name="email" placeholder="Your email address" autocomplete="email"><button type="submit" aria-label="Sign up" data-cursor="Join">→</button></div>
        <div class="seg" role="radiogroup" aria-label="Select your preference">
          <label><input type="radio" name="news-pref" value="man"><span>Man</span></label>
          <label><input type="radio" name="news-pref" value="women"><span>Women</span></label>
          <label><input type="radio" name="news-pref" value="both" checked><span>Both</span></label>
        </div>
        <label class="consent" for="news-ok"><input type="checkbox" id="news-ok"><span>I agree to receive email from AS SCHEDULED, and I have read and accept the <a href="privacy.html">privacy policy</a></span></label>
        <p class="form-msg" aria-live="polite"></p>
      </form>
      <div class="foot-cols">
        <div><h4>Support</h4><a href="cancellation-policy.html">Cancellation</a><a href="faqs.html">FAQ</a><a href="contact.html">Contact us</a></div>
        <div><h4>Join us</h4><a href="contact.html#collab">Collab</a><a href="apply.html">Apply</a></div>
        <div><h4>About us</h4><a href="about.html">About</a><a href="somewhere.html">Somewhere</a></div>
        <div><h4>Boring stuff</h4><a href="legal.html">Legal notice</a><a href="privacy.html">Privacy policy</a><a href="terms.html">Terms of travel</a></div>
      </div>
    </div>
  </div>
  <a class="foot-logo" href="index.html" aria-label="AS SCHEDULED home"><img src="/assets/brand/as-cream-xl.webp" alt="AS SCHEDULED" width="2380" height="368" loading="lazy"></a>
  <div class="foot-bottom">
    <div class="foot-social">{SOCIAL.map((s) => (<a href={s.href} target="_blank" rel="noopener">{s.label}</a>))}</div>
    <div class="foot-legal">info@asscheduled.com · +91 78530 22360 · +91 89692 14005<br>© <span data-year>2026</span> ROITCOVE VENTURES LLP · India</div>
  </div>
</footer>
